---
import SiteLayout from '../layouts/SiteLayout.astro';
import SolutionImage from './SolutionImage.astro';
import { solutions } from '../data/solutions';
import '../styles/solutions.css';
interface Props {
  locale: 'en' | 'fr';
}
const { locale } = Astro.props;
const en = locale === 'en';
const description = en
  ? 'Focused DEI services and practical products for businesses and government: hiring, learning, accessible communication, procurement and workplace materials.'
  : 'Des services ciblés en EDI et des produits pratiques pour les entreprises et le secteur public : recrutement, formation, communication accessible, approvisionnement et matériel.';
---

<SiteLayout
  locale={locale}
  title={en ? 'DEI services & products' : 'Services et produits en EDI'}
  description={description}
  path="solutions"
>
  <section class="page-hero">
    <div class="container">
      <nav class="breadcrumb" aria-label={en ? 'Breadcrumb' : 'Fil d’Ariane'}>
        <a href={`/${locale}/`}>{en ? 'Home' : 'Accueil'}</a><span
          aria-hidden="true">/</span
        ><span aria-current="page">{en ? 'Solutions' : 'Solutions'}</span>
      </nav>
      <div class="page-hero-split solution-hero">
        <div>
          <span class="eyebrow"
            >{
              en
                ? 'For business & government'
                : 'Pour les entreprises et le secteur public'
            }</span
          >
          <h1>
            {en ? 'A practical place to start.' : 'Un point de départ concret.'}
          </h1>
          <p class="lead">
            {
              en
                ? 'One job posting. One public document. One event. Start with a focused service or product that helps people participate, then build from there.'
                : 'Une offre d’emploi. Un document public. Un événement. Commencez par un service ou un produit ciblé qui facilite la participation, puis poursuivez la démarche.'
            }
          </p>
          <div class="button-row">
            <a class="button" href="#services"
              >{en ? 'Explore services' : 'Voir les services'}</a
            ><a class="text-link" href="#products"
              >{en ? 'Browse products' : 'Voir les produits'}</a>
          </div>
          <p class="solution-note">
            {
              en
                ? 'Defined scopes. English/French options. Quotes tailored to your requirements.'
                : 'Des mandats précis. Des options en français et en anglais. Des soumissions adaptées à vos besoins.'
            }
          </p>
        </div>
        <SolutionImage slug="inclusion-pulse-survey" locale={locale} />
      </div>
    </div>
  </section>
  {
    (['service', 'product'] as const).map((kind) => (
      <section
        class:list={['section', { 'soft-section': kind === 'product' }]}
        id={kind === 'service' ? 'services' : 'products'}
        aria-labelledby={`${kind}-title`}
      >
        <div class="container">
          <div class="section-intro">
            <>
              <div>
                <>
                  <span class="eyebrow">
                    {kind === 'service'
                      ? en
                        ? 'Focused services'
                        : 'Services ciblés'
                      : en
                        ? 'Products & materials'
                        : 'Produits et matériel'}
                  </span>
                  <h2 id={`${kind}-title`}>
                    {kind === 'service'
                      ? en
                        ? 'Make one useful change.'
                        : 'Faites avancer une priorité.'
                      : en
                        ? 'Put inclusion into everyday use.'
                        : 'Rendez l’inclusion tangible.'}
                  </h2>
                </>
              </div>
              <p class="lead">
                {kind === 'service'
                  ? en
                    ? 'Small engagements with a clear starting point, a defined output and a handover your team can use.'
                    : 'De petits mandats avec un point de départ clair, un livrable précis et un transfert utile à votre équipe.'
                  : en
                    ? 'Made-to-order and sourced options for workplaces and public spaces. Quantities, specifications, availability and delivery are confirmed in your quote.'
                    : 'Des options sur commande pour les milieux de travail et les espaces publics. Quantités, spécifications, disponibilité et livraison sont confirmées dans votre soumission.'}
              </p>
            </>
          </div>
          <div
            class:list={[
              'solution-grid',
              { 'solution-products': kind === 'product' },
            ]}
          >
            {solutions
              .filter((item) => item.kind === kind)
              .map((item) => (
                <a
                  class="solution-card"
                  href={`/${locale}/solutions/${item.slug}/`}
                >
                  <SolutionImage slug={item.slug} locale={locale} card />
                  <div class="solution-card-copy">
                    <h3>{item.title[locale]}</h3>
                    <p>{item.summary[locale]}</p>
                    <span class="service-link">
                      {en
                        ? 'View scope & details'
                        : 'Voir la portée et les détails'}
                    </span>
                  </div>
                </a>
              ))}
          </div>
        </div>
      </section>
    ))
  }
  <section class="section container" aria-labelledby="buying-title">
    <div class="section-intro">
      <div>
        <span class="eyebrow"
          >{
            en ? 'Buying with a clear scope' : 'Acheter avec un mandat clair'
          }</span
        ><h2 id="buying-title">
          {
            en
              ? 'Bring your brief. We’ll define the work.'
              : 'Partons de votre besoin pour définir le travail.'
          }
        </h2>
      </div><p class="lead">
        {
          en
            ? 'Choose a starting point above or send a brief. Services can stand alone or form part of a larger engagement.'
            : 'Choisissez un point de départ ci-dessus ou transmettez un résumé. Les services peuvent être autonomes ou faire partie d’un mandat plus large.'
        }
      </p>
    </div><div class="three-columns">
      <article>
        <h3>{en ? 'Agree on the output' : 'Convenir du résultat'}</h3><p>
          {
            en
              ? 'Confirm the files, materials, languages, quantities and review steps you need.'
              : 'Confirmez les fichiers, le matériel, les langues, les quantités et les étapes de révision nécessaires.'
          }
        </p>
      </article><article>
        <h3>
          {
            en
              ? 'Set acceptance criteria'
              : 'Définir les critères d’acceptation'
          }
        </h3><p>
          {
            en
              ? 'Identify your content owner, accessibility requirements, procurement process and approval dates.'
              : 'Précisez le responsable du contenu, les exigences d’accessibilité, le processus d’achat et les dates d’approbation.'
          }
        </p>
      </article><article>
        <h3>
          {en ? 'Review a tailored quote' : 'Examiner une soumission adaptée'}
        </h3><p>
          {
            en
              ? 'Review deliverables, responsibilities, pricing and timing before work or product ordering begins.'
              : 'Examinez les livrables, les responsabilités, les prix et les délais avant le début du travail ou la commande.'
          }
        </p>
      </article>
    </div><div class="button-row">
      <a class="button" href={`/${locale}/request-proposal/`}
        >{en ? 'Discuss your requirements' : 'Discuter de vos besoins'}</a
      ><a class="text-link" href={`/${locale}/procurement/`}
        >{en ? 'Procurement information' : 'Information pour les achats'}</a>
    </div>
  </section>
</SiteLayout>
