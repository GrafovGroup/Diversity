---
import { divisions, articles, pathFor, type Lang } from '../data/site';
import Picture from './Picture.astro';import Arrow from './Arrow.astro';
interface Props {lang:Lang;}
const {lang}=Astro.props;const t=(en:string,fr:string)=>lang==='fr'?fr:en;
---
<section class="home-hero container"><div class="hero-copy"><p class="eyebrow"><span class="tiny-line"></span>{t('CANADIAN CONSULTING & IMPLEMENTATION','CONSEIL ET MISE EN ŒUVRE AU CANADA')}</p><h1>{t('People.','Gens.')}<br/>{t('Opportunity.','Opportunités.')}<br/><span class="gradient-text">{t('Progress.','Progrès.')}</span></h1><p class="hero-intro">{t('Build a more inclusive organization. Turn your priorities into practical action.','Bâtissez une organisation plus inclusive. Transformez vos priorités en actions concrètes.')}</p><p class="hero-detail">{t('Advisory, learning and implementation for corporations and the public sector across Canada.','Conseil, formation et mise en œuvre pour les entreprises et le secteur public partout au Canada.')}</p><div class="button-row"><a class="button" href={pathFor('services',lang)}>{t('EXPLORE OUR EXPERTISE','EXPLORER NOS EXPERTISES')}<Arrow/></a><a class="text-link" href={pathFor('contact',lang)}>{t('LET’S TALK','PARLONS-EN')}<Arrow/></a></div><div class="hero-foot"><span>{t('STRATEGY','STRATÉGIE')}</span><span aria-hidden="true">/</span><span>{t('ADVISORY','CONSEIL')}</span><span aria-hidden="true">/</span><span>{t('IMPLEMENTATION','MISE EN ŒUVRE')}</span></div></div><div class="hero-visual"><Picture name="partnership" lang={lang} eager/><div class="photo-note"><span class="note-index">01 — 07</span><span>{t('Connected expertise.','Des expertises complémentaires.')}<br/><strong>{t('Practical possibilities.','Des possibilités concrètes.')}</strong></span><Arrow/></div><div class="hero-accent" aria-hidden="true"></div></div></section>
<section class="audience-band"><div class="container"><div class="section-top light"><p class="eyebrow">{t('WHO WE WORK WITH','QUI NOUS ACCOMPAGNONS')}</p><h2>{t('Your context shapes the work.','Votre contexte guide la démarche.')}</h2><p>{t('Different responsibilities. The same commitment to a clear scope and useful outcomes.','Des responsabilités différentes. La même attention à un mandat clair et à des résultats utiles.')}</p></div><div class="audience-grid">{[{id:'corporate',label:t('01 / CORPORATIONS','01 / ENTREPRISES'),title:t('Stronger organizations, from the inside out.','Des organisations plus solides, de l’intérieur.'),body:t('Connect people, leadership, accessibility and responsible purchasing to your business priorities.','Reliez les personnes, le leadership, l’accessibilité et les achats responsables à vos priorités.'),image:'corporate',cta:t('FOR CORPORATIONS','POUR LES ENTREPRISES')},{id:'government',label:t('02 / GOVERNMENT & PUBLIC SECTOR','02 / GOUVERNEMENT ET SECTEUR PUBLIC'),title:t('Progress in the public interest.','Des progrès au service de l’intérêt public.'),body:t('Define accessible services, workforce initiatives and procurement deliverables with accountability in mind.','Définissez les services accessibles, les initiatives de personnel et les livrables d’achat avec des responsabilités claires.'),image:'government',cta:t('FOR THE PUBLIC SECTOR','POUR LE SECTEUR PUBLIC')}].map(a=><article class="audience-card"><Picture name={a.image} lang={lang}/><div class="audience-content"><p class="eyebrow">{a.label}</p><h3>{a.title}</h3><p>{a.body}</p><a class="text-link" href={pathFor(a.id,lang)}>{a.cta}<Arrow/></a></div></article>)}</div></div></section>
<section class="section container expertise-section"><div class="section-heading"><div><p class="eyebrow">{t('OUR EXPERTISE','NOS EXPERTISES')}</p><h2>{t('Seven ways to move forward.','Sept façons d’avancer.')}</h2></div><p>{t('Start with one priority. Connect the disciplines you need as the work develops.','Commencez par une priorité. Reliez les disciplines nécessaires au fil du projet.')}</p></div><div class="expertise-layout"><div class="expertise-photo"><Picture name="accessibility" lang={lang}/><p>{t('People’s experiences are the starting point.','L’expérience des personnes est le point de départ.')}</p><a class="text-link" href={pathFor('approach',lang)}>{t('OUR APPROACH','NOTRE DÉMARCHE')}<Arrow/></a></div><div class="service-list">{divisions.map((d,i)=><a href={pathFor(d.key,lang)} class="service-row"><span class="service-index">{String(i+1).padStart(2,'0')}</span><div><h3>{d.title[lang]}</h3><p>{d.short[lang]}</p></div><Arrow/></a>)}</div></div></section>
<section class="approach-band"><div class="container approach-grid"><div><p class="eyebrow">{t('FROM INSIGHT TO ACTION','DE LA COMPRÉHENSION À L’ACTION')}</p><h2>{t('Good advice needs a way forward.','Le conseil doit ouvrir la voie à l’action.')}</h2><p>{t('An assessment is the beginning. We connect the findings to a plan, the plan to people, and the people to practical implementation.','L’évaluation est un début. Nous relions les constats à un plan, le plan aux personnes et les personnes à la mise en œuvre.')}</p><a class="text-link" href={pathFor('approach',lang)}>{t('HOW WE WORK','NOTRE DÉMARCHE')}<Arrow/></a></div><ol class="approach-steps">{[[t('Understand','Comprendre'),t('Listen, review and define the challenge.','Écouter, examiner et définir l’enjeu.')],[t('Prioritize','Prioriser'),t('Build a roadmap with clear owners.','Bâtir une feuille de route et préciser les rôles.')],[t('Activate','Concrétiser'),t('Equip teams and coordinate the work.','Outiller les équipes et coordonner le travail.')],[t('Review','Évaluer'),t('Check progress and plan the next step.','Examiner les progrès et planifier la suite.')]].map(([title,body],i)=><li><span>{String(i+1).padStart(2,'0')}</span><div><h3>{title}</h3><p>{body}</p></div></li>)}</ol></div></section>
<section class="section container national-section"><div><p class="eyebrow">{t('CANADA-WIDE PERSPECTIVE','UNE PERSPECTIVE PANCANADIENNE')}</p><h2>{t('National reach. Thoughtful local planning.','Une portée nationale. Une planification adaptée.')}</h2></div><div><p class="lead">{t('English and French. Corporate and public sector. Remote advisory and coordinated on-site work, scoped to your location.','Français et anglais. Entreprises et secteur public. Conseil à distance et interventions sur place, selon votre territoire.')}</p><p>{t('Travel, specialist availability and delivery arrangements are confirmed for each project. Explore the considerations for your province or territory.','Les déplacements, la disponibilité et les modalités sont confirmés pour chaque projet. Consultez les éléments propres à votre province ou territoire.')}</p><a class="text-link" href={pathFor('coverage',lang)}>{t('EXPLORE CANADIAN COVERAGE','EXPLORER LA COUVERTURE CANADIENNE')}<Arrow/></a></div></section>
<section class="section insights-section"><div class="container"><div class="section-heading"><div><p class="eyebrow">{t('PRACTICAL PERSPECTIVES','PERSPECTIVES PRATIQUES')}</p><h2>{t('A better starting point.','Un meilleur point de départ.')}</h2></div><a class="text-link" href={pathFor('resources',lang)}>{t('ALL INSIGHTS','TOUTES LES RESSOURCES')}<Arrow/></a></div><div class="article-grid">{articles.map(a=><article class="article-card"><a href={pathFor(a.id,lang)} tabindex="-1" aria-hidden="true"><Picture name={a.image!} lang={lang}/></a><p class="eyebrow">{a.eyebrow[lang]}</p><h3><a href={pathFor(a.id,lang)}>{a.title[lang]}</a></h3><p>{a.summary[lang]}</p><a class="text-link" href={pathFor(a.id,lang)} aria-label={`${t('Read','Lire')} : ${a.title[lang]}`}>{t('READ THE GUIDE','LIRE LE GUIDE')}<Arrow/></a></article>)}</div></div></section>
