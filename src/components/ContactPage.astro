---
import SiteLayout from '../layouts/SiteLayout.astro';
import PageImage from './PageImage.astro';
import EnquiryForm from './EnquiryForm.astro';
import type { FormLocale, EnquiryKind } from '../lib/forms';

interface Props {
  locale: FormLocale;
  kind?: EnquiryKind;
}
const { locale, kind = 'contact' } = Astro.props;
const fr = locale === 'fr';
const path = {
  contact: 'contact',
  proposal: 'request-proposal',
  assessment: 'request-assessment',
  training: 'training-enquiry',
}[kind];
const content = {
  contact: {
    title: fr
      ? 'Le progrès commence par une conversation.'
      : 'Progress starts with a conversation.',
    description: fr
      ? 'Parlons de vos objectifs en inclusion, en accessibilité et en transformation organisationnelle.'
      : 'Let’s talk about your goals for inclusion, accessibility and organizational change.',
    eyebrow: fr ? 'PARLONS-EN' : 'LET’S TALK',
  },
  proposal: {
    title: fr
      ? 'De votre ambition à un mandat clair.'
      : 'Turn your ambition into a clear brief.',
    description: fr
      ? 'Présentez vos objectifs, vos livrables attendus et vos exigences d’approvisionnement pour amorcer une proposition adaptée.'
      : 'Share your objectives, expected deliverables and procurement requirements to start a focused proposal.',
    eyebrow: fr ? 'DEMANDER UNE PROPOSITION' : 'REQUEST A PROPOSAL',
  },
  assessment: {
    title: fr
      ? 'Comprendre les obstacles. Définir la suite.'
      : 'Understand the barriers. Define what’s next.',
    description: fr
      ? 'Définissons la portée d’une évaluation de l’accessibilité de vos espaces, de vos services ou de vos expériences numériques.'
      : 'Scope an accessibility assessment of your spaces, services or digital experiences, with practical next steps in mind.',
    eyebrow: fr ? 'DEMANDER UNE ÉVALUATION' : 'REQUEST AN ASSESSMENT',
  },
  training: {
    title: fr
      ? 'Des apprentissages qui soutiennent l’action.'
      : 'Learning that moves into practice.',
    description: fr
      ? 'Explorons une formation adaptée à vos équipes, à leurs responsabilités et aux changements que vous souhaitez soutenir.'
      : 'Explore training shaped around your people, their responsibilities and the changes you want to support.',
    eyebrow: fr ? 'EXPLORER LA FORMATION' : 'EXPLORE TRAINING',
  },
}[kind];
const steps = fr
  ? [
      {
        title: 'Votre contexte',
        body: 'Décrivez la situation, les personnes concernées et les décisions à éclairer.',
      },
      {
        title: 'Une portée à préciser',
        body: 'Les méthodes, les livrables, les responsabilités et les besoins linguistiques se définissent ensemble.',
      },
      {
        title: 'Des prochaines étapes convenues',
        body: 'Tout mandat reste soumis à une proposition, aux disponibilités et à une entente écrite.',
      },
    ]
  : [
      {
        title: 'Your context',
        body: 'Describe the situation, the people involved and the decisions you need to make.',
      },
      {
        title: 'A scope to define',
        body: 'Methods, deliverables, responsibilities and language requirements are clarified together.',
      },
      {
        title: 'Agreed next steps',
        body: 'Every engagement remains subject to a proposal, availability and a written agreement.',
      },
    ];
---

<SiteLayout
  locale={locale}
  title={content.title}
  description={content.description}
  path={path}
>
  <section class="page-hero compact contact-hero">
    <div class="container">
      <nav class="breadcrumb" aria-label={fr ? 'Fil d’Ariane' : 'Breadcrumb'}>
        <a href={`/${locale}/`}>{fr ? 'Accueil' : 'Home'}</a><span
          aria-hidden="true">/</span
        ><span aria-current="page">{fr ? 'Contact' : 'Contact'}</span>
      </nav>
      <p class="eyebrow">{content.eyebrow}</p>
      <h1>{content.title}</h1>
      <p class="lead">{content.description}</p>
    </div>
  </section>
  <div class="container contact-visual">
    <PageImage path={path} locale={locale} />
  </div>
  <section
    class="section container contact-layout"
    aria-label={fr ? 'Votre demande' : 'Your enquiry'}
  >
    <EnquiryForm locale={locale} kind={kind} />
    <aside class="contact-aside">
      <div class="aside-intro">
        <p class="eyebrow">
          {fr ? 'UN BON POINT DE DÉPART' : 'A GOOD PLACE TO START'}
        </p><h2>
          {
            fr
              ? 'À l’écoute de votre organisation.'
              : 'Let’s understand your organization.'
          }
        </h2><p>
          {
            fr
              ? 'Une question précise ou un projet encore à définir? Votre point de départ nous aidera à orienter la conversation.'
              : 'A specific question or a project still taking shape? Your starting point helps guide the conversation.'
          }
        </p>
      </div>
      <ol class="contact-steps">
        {
          steps.map((step, index) => (
            <li>
              <>
                <span class="step-number" aria-hidden="true">
                  0{index + 1}
                </span>
                <div>
                  <>
                    <h3>{step.title}</h3>
                    <p>{step.body}</p>
                  </>
                </div>
              </>
            </li>
          ))
        }
      </ol>
      <div class="contact-direct">
        <h3>
          {fr ? 'Vous préférez nous écrire?' : 'Prefer to write directly?'}
        </h3><a href="mailto:info@diversity.ca"
          >info@diversity.ca <span aria-hidden="true">↗</span></a
        ><p>
          {
            fr
              ? 'La réception des messages à cette adresse doit être confirmée avant le lancement public. Pour une demande urgente, faites confirmer sa réception.'
              : 'Mailbox delivery needs confirmation before public launch. For any time-sensitive enquiry, confirm that your message has been received.'
          }
        </p>
      </div>
      {
        kind === 'proposal' && (
          <div class="procurement-note">
            <>
              <h3>
                {fr
                  ? 'Pour les équipes d’approvisionnement'
                  : 'For procurement teams'}
              </h3>
              <p>
                {fr
                  ? 'Indiquez le numéro de l’appel d’offres, la date limite et la marche à suivre. Une demande de renseignements ne constitue pas une soumission officielle.'
                  : 'Include the solicitation reference, closing date and required process. An enquiry does not constitute a formal bid submission.'}
              </p>
              <a href={`/${locale}/procurement/`}>
                {fr
                  ? 'Approvisionnement du secteur public'
                  : 'Public sector procurement'}{' '}
                <span aria-hidden="true">↗</span>
              </a>
            </>
          </div>
        )
      }
      {
        kind === 'assessment' && (
          <div class="procurement-note">
            <>
              <h3>
                {fr
                  ? 'Une évaluation à la bonne échelle'
                  : 'An assessment at the right scale'}
              </h3>
              <p>
                {fr
                  ? 'Précisez les bâtiments, les sites Web, les documents ou les parcours visés. Les critères applicables et les limites de l’évaluation seront établis dans la portée du mandat.'
                  : 'Identify the buildings, websites, documents or user journeys involved. Applicable criteria and assessment limits will be established in the engagement scope.'}
              </p>
            </>
          </div>
        )
      }
      {
        kind === 'training' && (
          <div class="procurement-note">
            <>
              <h3>
                {fr
                  ? 'Une formation adaptée à votre équipe'
                  : 'Training shaped around your team'}
              </h3>
              <p>
                {fr
                  ? 'Indiquez le nombre de personnes, les langues souhaitées, le format et les besoins d’accessibilité. Ces éléments orienteront la conception de la formation.'
                  : 'Include the group size, preferred languages, format and accessibility needs. These details will guide the learning design.'}
              </p>
            </>
          </div>
        )
      }
    </aside>
  </section>
</SiteLayout>

<style>
  .contact-hero h1 {
    max-width: 850px;
  }
  .contact-hero .lead {
    max-width: 740px;
  }
  .contact-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.65fr) minmax(270px, 1fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: start;
  }
  .contact-aside {
    padding: 1.5rem 0;
  }
  .contact-aside h2 {
    font-size: clamp(1.7rem, 2.5vw, 2.3rem);
    letter-spacing: -0.045em;
    line-height: 1.15;
    margin: 0.7rem 0 1.2rem;
  }
  .contact-aside h3 {
    font-size: 1.05rem;
    letter-spacing: -0.02em;
    margin: 0 0 0.5rem;
  }
  .contact-aside p {
    font-size: 0.95rem;
    line-height: 1.75;
    color: var(--muted, #5e6a7d);
  }
  .contact-steps {
    list-style: none;
    padding: 0;
    margin: 2rem 0;
  }
  .contact-steps li {
    display: grid;
    grid-template-columns: 2rem 1fr;
    gap: 1rem;
    padding: 1.3rem 0;
    border-top: 1px solid var(--line, #dce2ec);
  }
  .step-number {
    color: #174ea6;
    font-size: 0.75rem;
    font-weight: 700;
    padding-top: 0.2rem;
  }
  .contact-steps p {
    margin: 0;
  }
  .contact-direct {
    padding: 1.7rem 0;
    border-top: 1px solid var(--line, #dce2ec);
  }
  .contact-direct > a {
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--ink, #14233f);
    text-underline-offset: 5px;
  }
  .contact-direct p {
    font-size: 0.8rem;
    margin-top: 1rem;
  }
  .procurement-note {
    padding: 1.5rem;
    background: #f0f4fc;
    border-radius: 0.5rem;
  }
  .procurement-note p {
    font-size: 0.88rem;
  }
  .procurement-note a {
    font-size: 0.85rem;
    color: #174ea6;
    text-underline-offset: 3px;
  }
  @media (max-width: 960px) {
    .contact-layout {
      grid-template-columns: 1fr;
    }
    .contact-aside {
      max-width: 760px;
      padding: 0;
    }
    .contact-steps {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1.5rem;
    }
    .contact-steps li {
      grid-template-columns: 1fr;
      gap: 0.7rem;
    }
  }
  @media (max-width: 640px) {
    .contact-steps {
      display: block;
    }
    .contact-steps li {
      grid-template-columns: 2rem 1fr;
    }
  }
</style>
