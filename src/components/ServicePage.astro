---
import SiteLayout from '../layouts/SiteLayout.astro';
import PageImage from './PageImage.astro';
import CallToAction from './CallToAction.astro';
import EngagementGuide from './EngagementGuide.astro';
import type { Locale, Service, Subservice } from '../data/services';

interface Props {
  locale: Locale;
  service: Service;
  subservice?: Subservice;
}

const { locale, service, subservice } = Astro.props;
const en = locale === 'en';
const content = subservice ?? service;
const path = `services/${service.slug}${subservice ? `/${subservice.slug}` : ''}`;
const href = (page: string) => `/${locale}/${page}/`;
const enquiryPath = ['accessibility', 'implementation'].includes(service.slug)
  ? 'request-assessment'
  : service.slug === 'training'
    ? 'training-enquiry'
    : 'request-proposal';
const enquiryLabel =
  enquiryPath === 'request-assessment'
    ? en
      ? 'Request an assessment'
      : 'Demander une évaluation'
    : enquiryPath === 'training-enquiry'
      ? en
        ? 'Explore training'
        : 'Explorer la formation'
      : en
        ? 'Request a proposal'
        : 'Demander une proposition';
const enquiryParameters = new URLSearchParams({ service: service.slug });
if (subservice) enquiryParameters.set('subservice', subservice.slug);
const enquiryHref = `${href(enquiryPath)}?${enquiryParameters.toString()}`;
const guideKey = `${service.slug}${subservice ? `/${subservice.slug}` : ''}`;

const related = service.subservices.filter(
  (item) => item.slug !== subservice?.slug,
);
---

<SiteLayout
  locale={locale}
  title={content.title[locale]}
  description={content.intro[locale]}
  path={path}
>
  <section class="page-hero">
    <div class="container">
      <nav class="breadcrumb" aria-label={en ? 'Breadcrumb' : 'Fil d’Ariane'}>
        <a href={`/${locale}/`}>{en ? 'Home' : 'Accueil'}</a>
        <span aria-hidden="true">/</span>
        <a href={href('services')}>{en ? 'Expertise' : 'Expertises'}</a>
        <span aria-hidden="true">/</span>
        {
          subservice ? (
            <>
              <a href={href(`services/${service.slug}`)}>
                {service.shortTitle[locale]}
              </a>
              <span aria-hidden="true">/</span>
              <span aria-current="page">{subservice.title[locale]}</span>
            </>
          ) : (
            <span aria-current="page">{service.shortTitle[locale]}</span>
          )
        }
      </nav>
      <div class="page-hero-split">
        <div>
          <span class="eyebrow"
            >{service.number} / {
              subservice
                ? service.shortTitle[locale]
                : en
                  ? 'Our expertise'
                  : 'Nos expertises'
            }</span
          >
          <h1>{content.title[locale]}</h1>
          <p class="lead">{content.intro[locale]}</p>
          <div class="button-row">
            <a class="button" href={enquiryHref}
              >{enquiryLabel}<span aria-hidden="true">↗</span></a
            >
            <a class="text-link" href="#scope"
              >{en ? 'Explore the scope' : 'Découvrir la démarche'}<span
                aria-hidden="true">↓</span
              ></a
            >
          </div>
        </div>
        <PageImage path={path} locale={locale} />
      </div>
    </div>
  </section>

  <section class="section container" id="scope" aria-labelledby="scope-title">
    <div class="content-grid">
      <aside
        class="side-nav"
        aria-label={en ? 'On this page' : 'Sur cette page'}
      >
        <h2>{en ? 'In this service' : 'Dans ce service'}</h2>
        <a href="#scope">{en ? 'The scope' : 'La portée'}</a>
        <a href="#deliverables">{en ? 'What you receive' : 'Les livrables'}</a>
        <a href="#sample-deliverable"
          >{en ? 'Sample outline' : 'Exemple de structure'}</a
        >
        <a href="#prepare"
          >{en ? 'What to prepare' : 'Préparer le premier échange'}</a
        >
        <a href="#scope-boundaries"
          >{en ? 'Scope and responsibilities' : 'Portée et responsabilités'}</a
        >
        <a href="#process"
          >{en ? 'How the work takes shape' : 'Le déroulement du mandat'}</a
        >
        <a href="#related"
          >{en ? 'Related capabilities' : 'Expertises connexes'}</a
        >
        <a href="#questions"
          >{en ? 'Common questions' : 'Questions fréquentes'}</a
        >
      </aside>
      <div>
        <div class="content-section">
          <span class="eyebrow"
            >{
              en
                ? 'From your priorities to a practical scope'
                : 'De vos priorités à un mandat concret'
            }</span
          >
          <h2 id="scope-title">
            {
              subservice
                ? subservice.intro[locale]
                : en
                  ? 'A clear starting point. A considered way forward.'
                  : 'Un point de départ clair. Une démarche réfléchie.'
            }
          </h2>
          <p>{content.description[locale]}</p>
        </div>
        {
          !subservice && (
            <div class="content-section">
              <h2>
                {en
                  ? 'What the work is designed to support'
                  : 'Ce que la démarche vise à soutenir'}
              </h2>
              <ul>
                {service.outcomes[locale].map((outcome) => (
                  <li>{outcome}</li>
                ))}
              </ul>
            </div>
          )
        }
        <div class="content-section" id="deliverables">
          <h2>{en ? 'What you receive' : 'Les livrables'}</h2>
          <p>
            {
              en
                ? 'The final scope is agreed with your team. A focused engagement can include:'
                : 'La portée définitive est convenue avec votre équipe. Un mandat ciblé peut comprendre :'
            }
          </p>
          <ul>
            {
              content.deliverables[locale].map((deliverable) => (
                <li>{deliverable}</li>
              ))
            }
          </ul>
        </div>
        <EngagementGuide locale={locale} guideKey={guideKey} />
        {
          subservice && (
            <div class="content-section">
              <h2>
                {en
                  ? 'Connected to the bigger picture'
                  : 'Une démarche liée à vos objectifs d’ensemble'}
              </h2>
              <p>{service.description[locale]}</p>
              <a class="text-link" href={href(`services/${service.slug}`)}>
                {en
                  ? `Explore ${service.shortTitle.en.toLowerCase()}`
                  : `Découvrir : ${service.shortTitle.fr}`}
                <span aria-hidden="true">↗</span>
              </a>
            </div>
          )
        }
      </div>
    </div>
  </section>

  <section
    class="soft-section section"
    id="related"
    aria-labelledby="related-title"
  >
    <div class="container">
      <div class="section-intro">
        <div>
          <span class="eyebrow"
            >{en ? 'Focused expertise' : 'Des expertises ciblées'}</span
          ><h2 id="related-title">
            {
              subservice
                ? en
                  ? 'Explore related services.'
                  : 'Découvrez les services connexes.'
                : en
                  ? 'Find the support your organization needs.'
                  : 'Trouvez le soutien dont votre organisation a besoin.'
            }
          </h2>
        </div>
        <p class="lead">
          {
            en
              ? 'Start with one priority or bring several workstreams together. We define the right combination with you.'
              : 'Ciblez une priorité ou réunissez plusieurs volets. Nous définissons avec vous la combinaison appropriée.'
          }
        </p>
      </div>
      <div class="subservice-grid">
        {
          related.map((item) => (
            <article class="subservice-card">
              <h3>{item.title[locale]}</h3>
              <p>{item.intro[locale]}</p>
              <a
                class="text-link"
                href={href(`services/${service.slug}/${item.slug}`)}
                aria-label={`${en ? 'Explore this service' : 'Découvrir ce service'} : ${item.title[locale]}`}
              >
                {en ? 'Explore this service' : 'Découvrir ce service'}
                <span aria-hidden="true">↗</span>
              </a>
            </article>
          ))
        }
        {
          subservice && (
            <article class="subservice-card">
              <h3>
                {en
                  ? 'Build a connected engagement.'
                  : 'Construisez une démarche cohérente.'}
              </h3>
              <p>
                {en
                  ? 'See the wider division, its methods and the outcomes the work is designed to support.'
                  : 'Découvrez l’ensemble du domaine, les méthodes et les résultats que la démarche vise à soutenir.'}
              </p>
              <a class="text-link" href={href(`services/${service.slug}`)}>
                {en ? 'View the full division' : 'Voir l’ensemble du domaine'}
                <span aria-hidden="true">↗</span>
              </a>
            </article>
          )
        }
      </div>
    </div>
  </section>

  <section
    class="section container"
    id="process"
    aria-labelledby="process-title"
  >
    <div class="approach-section">
      <div>
        <span class="eyebrow"
          >{en ? 'The way we work' : 'Notre façon de travailler'}</span
        >
        <h2 id="process-title">
          {
            en
              ? 'Clear steps. Shared understanding.'
              : 'Des étapes claires. Une compréhension commune.'
          }
        </h2>
        <p class="lead">
          {
            en
              ? 'We shape each engagement around your starting point, your capacity and the decisions ahead. Responsibilities, methods and deliverables are confirmed before work begins.'
              : 'Chaque mandat tient compte de votre situation, de vos capacités et des décisions à venir. Les responsabilités, les méthodes et les livrables sont confirmés avant le début des travaux.'
          }
        </p>
        <a class="text-link" href={enquiryHref}
          >{enquiryLabel}<span aria-hidden="true">↗</span></a
        >
      </div>
      <ol class="service-process" role="list">
        {
          service.process[locale].map((step, index) => (
            <li class="approach-step">
              <>
                <span class="step-number" aria-hidden="true">
                  {String(index + 1).padStart(2, '0')}
                </span>
                <p>{step}</p>
              </>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section
    class="soft-section section"
    id="questions"
    aria-labelledby="questions-title"
  >
    <div class="container">
      <div class="section-intro">
        <div>
          <span class="eyebrow"
            >{en ? 'Before we begin' : 'Avant de commencer'}</span
          ><h2 id="questions-title">
            {
              en
                ? 'Your questions, considered.'
                : 'Des réponses à vos questions.'
            }
          </h2>
        </div>
      </div>
      <div class="faq-list">
        {
          service.faq[locale].map((item) => (
            <details>
              <>
                <summary>{item.q}</summary>
                <p>{item.a}</p>
              </>
            </details>
          ))
        }
      </div>
    </div>
  </section>
  <CallToAction
    locale={locale}
    destination={enquiryHref}
    label={enquiryLabel}
  />
</SiteLayout>

<style>
  .service-process {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 1px solid var(--line);
  }
  .service-process .approach-step p {
    padding-top: 2px;
    font-size: 0.95rem;
    line-height: 1.8;
  }
</style>
