---
import { formEndpoint } from '../lib/form-endpoint';
interface Props {
  locale: 'en' | 'fr';
  partner?: boolean;
}
const { locale, partner = false } = Astro.props;
const en = locale === 'en';
const kind = partner ? 'bid-partnership' : 'bid-invitation';
const subject = partner
  ? 'Diversity.ca — Bid partnership'
  : 'Diversity.ca — Invitation to bid';
const title = partner
  ? en
    ? 'Discuss a bid partnership'
    : 'Discuter d’un partenariat de soumission'
  : en
    ? 'Invite Diversity.ca to bid'
    : 'Inviter Diversity.ca à soumissionner';
const scope = partner
  ? en
    ? 'Which part of the contract would you like us to deliver?'
    : 'Quel volet du mandat souhaitez-vous nous confier?'
  : en
    ? 'What work would you like us to bid on?'
    : 'Quels travaux souhaitez-vous nous confier?';
---

<details id={kind} class="bid-intake" data-intake>
  <summary>
    <span class="eyebrow"
      >{
        partner
          ? en
            ? 'For prime contractors'
            : 'Pour les entreprises soumissionnaires'
          : en
            ? 'For procurement teams'
            : 'Pour les équipes d’approvisionnement'
      }</span
    >
    <strong>{title}</strong>
  </summary>
  <div class="bid-body">
    <p>
      {
        en
          ? 'Share a public notice or a short, non-confidential brief. Use the buyer’s official portal for formal submissions.'
          : 'Transmettez un avis public ou un bref résumé non confidentiel. Pour déposer une soumission officielle, utilisez le portail de l’acheteur.'
      }
    </p>
    {
      formEndpoint && (
        <form
          method="post"
          action={formEndpoint}
          data-bid-form
          data-locale={locale}
        >
          <input type="hidden" name="enquiry_type" value={kind} />
          <input type="hidden" name="_subject" value={subject} />
          <input type="hidden" name="locale" value={locale} />
          <input
            type="text"
            name="_gotcha"
            hidden
            tabindex="-1"
            autocomplete="off"
            aria-hidden="true"
          />
          <div class="bid-fields">
            <label>
              {en ? 'Organization' : 'Organisation'} *
              <input
                name="organization"
                required
                autocomplete="organization"
                maxlength="160"
              />
            </label>
            <label>
              {en ? 'Contact email' : 'Courriel de la personne-ressource'} *
              <input
                name="email"
                type="email"
                required
                autocomplete="email"
                maxlength="254"
              />
            </label>
            <label>
              {en
                ? 'Public notice link (optional)'
                : 'Lien vers l’avis public (facultatif)'}
              <input
                name="solicitation_url"
                type="url"
                placeholder="https://"
                pattern="https?://.+"
                maxlength="1000"
              />
            </label>
            <label>
              {en
                ? 'Solicitation number (optional)'
                : 'Numéro de l’appel d’offres (facultatif)'}
              <input name="reference" maxlength="100" />
            </label>
            <label>
              {en
                ? 'Closing date and time (if known)'
                : 'Date et heure limites (si connues)'}
              <input name="closing_local" type="datetime-local" />
            </label>
            <label>
              {en ? 'Closing time zone' : 'Fuseau horaire de l’échéance'}
              <input
                name="closing_timezone"
                maxlength="80"
                placeholder={en ? 'e.g. Eastern' : 'p. ex. heure de l’Est'}
              />
            </label>
            <label class="bid-wide">
              {scope} *
              <textarea name="message" required maxlength="4000" rows="3" />
            </label>
          </div>
          <button type="submit" class="button">
            {partner
              ? en
                ? 'Send partnership enquiry'
                : 'Envoyer la demande de partenariat'
              : en
                ? 'Send bid invitation'
                : 'Envoyer l’invitation à soumissionner'}
          </button>
          <p role="status" aria-live="polite" data-feedback />
        </form>
      )
    }
    <div data-confirm hidden tabindex="-1">
      <h3>
        {
          partner
            ? en
              ? 'Partnership enquiry received.'
              : 'Demande de partenariat reçue.'
            : en
              ? 'Bid invitation received.'
              : 'Invitation à soumissionner reçue.'
        }
      </h3>
      <p>
        {
          en
            ? 'Thank you. We’ll review the scope and use the contact email you provided to follow up.'
            : 'Merci. Nous examinerons le mandat et ferons le suivi à l’adresse courriel indiquée.'
        }
      </p>
    </div>
    <p class="direct">
      {en ? 'Prefer email?' : 'Vous préférez le courriel?'}
      <a
        href={`mailto:info@diversity.ca?subject=${encodeURIComponent(subject)}`}
        >info@diversity.ca</a>
    </p>
  </div>
</details>
<script>
  function openIntake() {
    const target = document.getElementById(location.hash.slice(1));
    if (
      target instanceof HTMLDetailsElement &&
      target.hasAttribute('data-intake')
    ) {
      target.open = true;
    }
  }
  openIntake();
  window.addEventListener('hashchange', openIntake);
  document
    .querySelectorAll<HTMLAnchorElement>('a[href*="#bid-"]')
    .forEach((link) =>
      link.addEventListener('click', () => {
        const section = document.getElementById(link.hash.slice(1));
        if (section instanceof HTMLDetailsElement) section.open = true;
      }),
    );
  document
    .querySelectorAll<HTMLFormElement>('[data-bid-form]')
    .forEach((form) => {
      const en = form.dataset.locale === 'en';
      const closing = form.elements.namedItem(
        'closing_local',
      ) as HTMLInputElement;
      const zone = form.elements.namedItem(
        'closing_timezone',
      ) as HTMLInputElement;
      const validateZone = () => (zone.required = Boolean(closing.value));
      closing.addEventListener('input', validateZone);
      const button = form.querySelector('button')!;
      const feedback = form.querySelector<HTMLElement>('[data-feedback]')!;
      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        if (button.disabled) return;
        validateZone();
        if (!form.reportValidity()) return;
        const data = new FormData(form);
        if (String(data.get('_gotcha') ?? '').trim()) return;
        button.disabled = true;
        form.setAttribute('aria-busy', 'true');
        feedback.textContent = en ? 'Sending…' : 'Envoi en cours…';
        try {
          const response = await fetch(form.action, {
            method: 'POST',
            body: data,
            headers: { Accept: 'application/json' },
            signal: AbortSignal.timeout(20000),
          });
          if (!response.ok) throw new Error('Submission failed');
          form.reset();
          form.hidden = true;
          const confirmation =
            form.parentElement!.querySelector<HTMLElement>('[data-confirm]')!;
          confirmation.hidden = false;
          confirmation.focus();
        } catch {
          feedback.textContent = en
            ? 'Delivery could not be confirmed. Your entries are still here. Try again or email info@diversity.ca.'
            : 'L’envoi n’a pu être confirmé. Vos renseignements sont conservés dans le formulaire. Réessayez ou écrivez à info@diversity.ca.';
        } finally {
          button.disabled = false;
          form.removeAttribute('aria-busy');
        }
      });
    });
</script>
<style>
  .bid-intake {
    border-block-start: 1px solid var(--line);
    scroll-margin-top: 6.5rem;
  }
  summary {
    padding: 1.5rem 2rem 1.5rem 0;
    cursor: pointer;
    position: relative;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary::after {
    content: '+';
    position: absolute;
    right: 0.1rem;
    top: 50%;
    transform: translateY(-50%);
    font-size: 1.6rem;
    color: var(--navy);
  }
  details[open] > summary::after {
    content: '−';
  }
  summary strong {
    font-size: clamp(1.15rem, 2vw, 1.55rem);
    line-height: 1.26;
    display: block;
  }
  summary .eyebrow {
    margin-bottom: 0.35rem;
    color: var(--muted);
  }
  .bid-body {
    padding: 0 0.1rem 1.5rem;
  }
  .bid-body p {
    font-size: 0.94rem;
    color: var(--muted);
  }
  .bid-fields {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin: 1.25rem 0;
  }
  label {
    display: grid;
    align-content: start;
    gap: 0.35rem;
    font-weight: 600;
    color: var(--ink);
    font-size: 0.86rem;
  }
  input,
  textarea {
    font: inherit;
    font-weight: 400;
    border: 1px solid #8794a7;
    border-radius: 6px;
    padding: 0.7rem;
    min-width: 0;
    width: 100%;
    box-sizing: border-box;
    color: var(--ink);
    background: white;
  }
  input:focus,
  textarea:focus,
  summary:focus-visible {
    outline: 2px solid #2958c5;
    outline-offset: 2px;
  }
  .bid-wide {
    grid-column: 1/-1;
  }
  textarea {
    resize: vertical;
  }
  .direct {
    margin: 0.65rem 0 0;
  }
  .direct a {
    text-decoration: underline;
  }
  [data-feedback]:empty {
    display: none;
  }
  [data-confirm] {
    text-align: center;
    padding: 1.5rem;
    background: #f1f5fb;
    border-radius: 8px;
  }
  [data-confirm] h3 {
    font-size: 1.6rem;
  }
  @media (max-width: 620px) {
    .bid-fields {
      grid-template-columns: 1fr;
    }
  }
</style>
