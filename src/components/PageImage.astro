---
import { pageImages } from '../data/page-images';
interface Props {
  path: string;
  locale: 'en' | 'fr';
  class?: string;
  sizes?: string;
  priority?: boolean;
}
const { path, locale, class: className, sizes, priority = true } = Astro.props;
const visual = pageImages[path];
if (!visual) throw new Error(`Missing page image for ${path}`);
---

<img
  data-page-image={path || 'home'}
  class:list={[
    className,
    {
      'editorial-illustration': visual.src.endsWith('.svg'),
      'full-frame': visual.fit === 'contain',
      'service-photograph': visual.src.startsWith('/images/services/'),
    },
  ]}
  src={visual.src}
  srcset={visual.srcset}
  sizes={sizes ?? visual.sizes}
  alt={visual.alt[locale]}
  width={visual.width ?? 1200}
  height={visual.height ?? 900}
  style={{ objectFit: visual.fit, objectPosition: visual.objectPosition }}
  loading={priority ? 'eager' : 'lazy'}
  decoding="async"
  fetchpriority={priority ? 'high' : 'auto'}
/>
