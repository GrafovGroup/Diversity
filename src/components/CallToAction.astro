---
interface Props {
  locale: 'en' | 'fr';
  destination?: string;
  label?: string;
}
const {
  locale,
  destination = `/${Astro.props.locale}/request-proposal/`,
  label,
} = Astro.props;
const en = locale === 'en';
---

<section class="cta-band">
  <div class="container cta-inner">
    <div>
      <span class="eyebrow"
        >{
          en
            ? 'THE NEXT STEP STARTS WITH A CONVERSATION'
            : 'LE PROCHAIN PAS COMMENCE PAR UNE CONVERSATION'
        }</span
      ><h2>
        {
          en
            ? 'Let’s turn your priorities into meaningful progress.'
            : 'Transformons vos priorités en progrès concrets.'
        }
      </h2>
    </div><a class="button button-white" href={destination}
      >{label ?? (en ? 'Start a conversation' : 'Entamons la conversation')}</a
    >
  </div>
</section>
