---
import SiteLayout from '../layouts/SiteLayout.astro';
import '../styles/home-hero.css';
import PageImage from './PageImage.astro';
import { homeImages } from '../data/page-images';
import CallToAction from './CallToAction.astro';
import SolutionsTeaser from './SolutionsTeaser.astro';
import CoverageLinks from './CoverageLinks.astro';
import { services } from '../data/services';
import { articles } from '../data/pages';
interface Props {
  locale: 'en' | 'fr';
}
const { locale } = Astro.props;
const en = locale === 'en';
const href = (p: string) => `/${locale}/${p}/`;
const steps = en
  ? [
      [
        'Listen & understand',
        'Start with your people, your context and the barriers that matter.',
      ],
      [
        'Design a practical path',
        'Connect evidence to clear priorities, shared responsibilities and an achievable plan.',
      ],
      [
        'Move forward, together',
        'Put plans into practice, build internal capacity and review what changes.',
      ],
    ]
  : [
      [
        'Écouter et comprendre',
        'Partir de vos équipes, de votre contexte et des obstacles qui comptent.',
      ],
      [
        'Tracer un parcours concret',
        'Relier les constats à des priorités claires, des responsabilités partagées et un plan réaliste.',
      ],
      [
        'Avancer ensemble',
        'Mettre les plans en œuvre, renforcer les capacités et examiner les changements.',
      ],
    ];
const articleImages = ['@home-guide-1', '@home-guide-2', '@home-guide-3'];
---

<SiteLayout
  locale={locale}
  title={en ? 'People. Opportunity. Progress.' : 'Gens. Opportunités. Progrès.'}
  description={en
    ? 'Advisory, training and implementation for more inclusive organizations and accessible places across Canada. Explore seven connected areas of expertise.'
    : 'Conseil, formation et mise en œuvre pour des organisations plus inclusives et des lieux plus accessibles au Canada. Découvrez sept expertises complémentaires.'}
>
  <section
    class:list={['home-hero', { 'home-hero--light': !en }]}
    aria-labelledby="home-title"
  >
    {
      en && (
        <div class="hero-backdrop">
          <PageImage path="" locale={locale} />
        </div>
      )
    }
    <div class="container hero-inner">
      <div class="hero-copy">
        <span class="eyebrow"
          >{
            en
              ? 'ADVISORY. TRAINING. IMPLEMENTATION.'
              : 'CONSEIL. FORMATION. MISE EN ŒUVRE.'
          }</span
        ><h1 id="home-title">
          {en ? 'People.' : 'Gens.'}<br />{
            en ? 'Opportunity.' : 'Opportunités.'
          }<br /><em>{en ? 'Progress.' : 'Progrès.'}</em>
        </h1><p class="lead">
          {
            en
              ? 'Building more inclusive organizations. Creating more accessible places. Turning good intentions into practical, lasting change.'
              : 'Bâtir des organisations plus inclusives. Créer des lieux plus accessibles. Transformer les bonnes intentions en changements concrets et durables.'
          }
        </p><div class="button-row">
          <a href={href('services')} class="button"
            >{en ? 'Explore our expertise' : 'Découvrir nos expertises'}</a
          ><a href={href('contact')} class="button button-outline"
            >{en ? 'Let’s talk' : 'Parlons-en'}</a
          >
        </div><p class="hero-note">
          {
            en
              ? 'For corporations, governments and the people they serve.'
              : 'Pour les entreprises, les gouvernements et leurs communautés.'
          }
        </p>
      </div>
      {
        !en && (
          <figure class="hero-feature">
            <PageImage
              path=""
              locale={locale}
              sizes="(max-width: 900px) calc(100vw - 32px), (min-width: 1896px) 850px, 46vw"
            />
            <figcaption>
              De nouvelles perspectives. Plus de possibilités.
            </figcaption>
          </figure>
        )
      }
    </div>
  </section>
  <section
    class="purpose-strip"
    aria-label={en ? 'Our focus' : 'Nos priorités'}
  >
    <div class="container purpose-inner">
      <span
        >{
          en
            ? 'CONNECTED EXPERTISE.\nONE SHARED PURPOSE.'
            : 'DES EXPERTISES COMPLÉMENTAIRES.\nUNE AMBITION COMMUNE.'
        }</span
      ><div>
        {en ? 'People & organizations' : 'Personnes et organisations'}
      </div><div>
        {en ? 'Places & accessibility' : 'Lieux et accessibilité'}
      </div><div>
        {en ? 'Opportunity & impact' : 'Opportunités et retombées'}
      </div>
    </div>
  </section>
  <section class="section container">
    <div class="section-intro">
      <div>
        <span class="eyebrow">{en ? 'OUR EXPERTISE' : 'NOS EXPERTISES'}</span
        ><h2>
          {
            en
              ? 'Different challenges.\nConnected solutions.'
              : 'Des défis variés.\nDes solutions complémentaires.'
          }
        </h2>
      </div><p class="lead">
        {
          en
            ? 'Seven areas of expertise, brought together around your organization’s priorities — from the first assessment to implementation.'
            : 'Sept domaines d’expertise réunis autour des priorités de votre organisation, de la première évaluation à la mise en œuvre.'
        }
      </p>
    </div><div class="service-grid">
      {
        services.map((service) => (
          <a class="service-card" href={href(`services/${service.slug}`)}>
            <>
              <h3>{service.shortTitle[locale]}</h3>
              <p>{service.intro[locale]}</p>
              <span class="service-link">
                {en ? 'View services' : 'Découvrir les services'}
              </span>
            </>
          </a>
        ))
      }<a class="service-card cta-card" href={href('request-proposal')}
        ><div class="card-top">
          <span class="eyebrow no-margin"
            >{en ? 'YOUR NEXT CHAPTER' : 'VOTRE PROCHAIN CHAPITRE'}</span
          >
        </div><h3>
          {en ? 'Where do you\nwant to go?' : 'Où souhaitez-vous\naller?'}
        </h3><p>
          {
            en
              ? 'Let’s build the path forward.'
              : 'Traçons ensemble la voie à suivre.'
          }
        </p><span class="service-link"
          >{en ? 'Discuss your project' : 'Parlons de votre projet'}</span
        ></a
      >
    </div>
  </section>
  <section class="audience-section">
    <div class="container">
      <div class="section-intro">
        <div>
          <span class="eyebrow"
            >{en ? 'BUILT AROUND YOUR WORLD' : 'ANCRÉ DANS VOTRE RÉALITÉ'}</span
          ><h2>{en ? 'Your context matters.' : 'Votre contexte compte.'}</h2>
        </div><p class="lead">
          {
            en
              ? 'Different responsibilities. Shared ambitions for workplaces, services and communities that work better for everyone.'
              : 'Des responsabilités différentes. Une ambition commune : des milieux de travail, des services et des communautés qui répondent mieux aux besoins de tous.'
          }
        </p>
      </div><div class="audience-grid">
        <a
          class="audience-card audience-card-framed"
          href={href('corporations')}
          ><img
            src={homeImages['@home-corporations'].src}
            alt=""
            width="1500"
            height="1000"
            loading="lazy"
          /><div class="audience-content">
            <span class="eyebrow"
              >{en ? 'FOR CORPORATIONS' : 'POUR LES ENTREPRISES'}</span
            ><h3>
              {
                en
                  ? 'Stronger organizations.\nGreater possibility.'
                  : 'Des organisations plus fortes.\nDe nouvelles possibilités.'
              }
            </h3><p>
              {
                en
                  ? 'Connect your people strategy, customer experience and operations to a more inclusive way of doing business.'
                  : 'Reliez votre stratégie RH, l’expérience client et vos activités à des pratiques plus inclusives.'
              }
            </p><span class="text-link"
              >{
                en
                  ? 'Explore corporate solutions'
                  : 'Découvrir les solutions pour les entreprises'
              }
            </span>
          </div></a
        ><a class="audience-card audience-card-framed" href={href('government')}
          ><img
            src={homeImages['@home-government'].src}
            alt=""
            width="1200"
            height="800"
            loading="lazy"
          /><div class="audience-content">
            <span class="eyebrow"
              >{
                en
                  ? 'FOR GOVERNMENT & PUBLIC SECTOR'
                  : 'POUR LES GOUVERNEMENTS ET LE SECTEUR PUBLIC'
              }</span
            ><h3>
              {
                en
                  ? 'Public purpose.\nPractical progress.'
                  : 'Une mission publique.\nDes progrès concrets.'
              }
            </h3><p>
              {
                en
                  ? 'Bring accessibility, equitable service and accountable delivery into the plans that shape your community.'
                  : 'Intégrez l’accessibilité, des services équitables et une prestation responsable aux plans qui façonnent votre communauté.'
              }
            </p><span class="text-link"
              >{
                en
                  ? 'Explore public sector solutions'
                  : 'Découvrir les solutions pour le secteur public'
              }
            </span>
          </div></a
        >
      </div>
    </div>
  </section>
  <section class="section container approach-section">
    <div>
      <span class="eyebrow"
        >{en ? 'FROM INTENTION TO ACTION' : 'DE L’INTENTION À L’ACTION'}</span
      ><h2>
        {
          en
            ? 'A clear path.\nA human approach.'
            : 'Un parcours clair.\nUne approche humaine.'
        }
      </h2><p class="lead">
        {
          en
            ? 'Progress is built with people, not simply planned for them. We connect listening, thoughtful design and practical implementation.'
            : 'Le progrès se construit avec les personnes concernées. Notre démarche relie l’écoute, une conception réfléchie et la mise en œuvre concrète.'
        }
      </p><a class="text-link" href={href('approach')}
        >{en ? 'Discover our approach' : 'Découvrir notre approche'}
      </a>
    </div><div class="approach-steps">
      {
        steps.map(([title, body], i) => (
          <div class="approach-step">
            <>
              <span class="step-number">0{i + 1}</span>
              <div>
                <>
                  <h3>{title}</h3>
                  <p>{body}</p>
                </>
              </div>
            </>
          </div>
        ))
      }
    </div>
  </section>
  <section class="soft-section">
    <div class="section container">
      <div class="section-intro">
        <div>
          <span class="eyebrow"
            >{en ? 'IDEAS FOR THE WAY FORWARD' : 'DES IDÉES POUR AVANCER'}</span
          ><h2>
            {
              en
                ? 'Perspectives into practice.'
                : 'Des perspectives à la pratique.'
            }
          </h2>
        </div><a class="text-link" href={href('insights')}
          >{en ? 'All insights' : 'Toutes les perspectives'}
        </a>
      </div><div class="insights-grid">
        {
          articles.map((article, i) => (
            <a class="insight-card" href={href(`insights/${article.slug}`)}>
              <>
                <div class="image-wrap">
                  <img
                    src={homeImages[articleImages[i]].src}
                    class:list={{
                      'editorial-illustration':
                        homeImages[articleImages[i]].src.endsWith('.svg'),
                    }}
                    alt=""
                    width="800"
                    height="600"
                    loading="lazy"
                  />
                </div>
                <span class="eyebrow">
                  {en ? 'PRACTICAL GUIDE' : 'GUIDE PRATIQUE'} ·{' '}
                  {en ? '5 MIN READ' : 'LECTURE DE 5 MIN'}
                </span>
                <h3>{article.title[locale]}</h3>
                <span class="text-link">
                  {en ? 'Read the guide' : 'Lire le guide'}{' '}
                </span>
              </>
            </a>
          ))
        }
      </div>
    </div>
  </section>
  <SolutionsTeaser locale={locale} />
  <CoverageLinks locale={locale} />
  <CallToAction locale={locale} />
</SiteLayout>
