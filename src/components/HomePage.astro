---
import SiteLayout from '../layouts/SiteLayout.astro';
import '../styles/home-hero.css';
import PageImage from './PageImage.astro';
import { homeImages } from '../data/page-images';
import CallToAction from './CallToAction.astro';
import SolutionsTeaser from './SolutionsTeaser.astro';
import CoverageLinks from './CoverageLinks.astro';
import { articles } from '../data/pages';
interface Props {
  locale: 'en' | 'fr';
}
const { locale } = Astro.props;
const en = locale === 'en';
const href = (p: string) => `/${locale}/${p}/`;
const steps = en
  ? [
      [
        'Listen & understand',
        'Start with your people, your context and the barriers that matter.',
      ],
      [
        'Design a practical path',
        'Connect evidence to clear priorities, shared responsibilities and an achievable plan.',
      ],
      [
        'Move forward, together',
        'Put plans into practice, build internal capacity and review what changes.',
      ],
    ]
  : [
      [
        'Écouter et comprendre',
        'Partir de vos équipes, de votre contexte et des obstacles qui comptent.',
      ],
      [
        'Tracer un parcours concret',
        'Relier les constats à des priorités claires, des responsabilités partagées et un plan réaliste.',
      ],
      [
        'Avancer ensemble',
        'Mettre les plans en œuvre, renforcer les capacités et examiner les changements.',
      ],
    ];
const articleImages = ['@home-guide-1', '@home-guide-2', '@home-guide-3'];
const homepageServices = [
  {
    slug: 'dei',
    title: [
      'Diversity & inclusion strategy',
      'Stratégie de diversité et d’inclusion',
    ],
    summary: [
      'Practical strategies for measurable progress.',
      'Des stratégies concrètes pour des progrès mesurables.',
    ],
    icon: 'M16 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8ZM8 28v-4a8 8 0 0 1 16 0v4M5 10a3 3 0 0 0 0 6m22-6a3 3 0 0 1 0 6M2 27v-3a6 6 0 0 1 4-6m24 9v-3a6 6 0 0 0-4-6',
  },
  {
    slug: 'training',
    title: ['Training & development', 'Formation et perfectionnement'],
    summary: [
      'Programs for lasting change.',
      'Des programmes pour un changement durable.',
    ],
    icon: 'M3 6h10l3 3 3-3h10v20H19l-3 3-3-3H3ZM16 9v20M7 12h5M7 17h5m8-5h5m-5 5h5',
  },
  {
    slug: 'accessibility',
    title: ['Accessibility solutions', 'Solutions d’accessibilité'],
    summary: [
      'More inclusive spaces and services.',
      'Des espaces et services plus accessibles.',
    ],
    icon: 'M16 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6ZM4 12l12 3 12-3M16 15v6m0 0-7 9m7-9 7 9',
  },
  {
    slug: 'people-culture',
    title: ['HR & organizational advisory', 'Conseil en RH et organisation'],
    summary: [
      'Better systems, stronger teams.',
      'De meilleurs systèmes, des équipes plus fortes.',
    ],
    icon: 'M12 3h8v7h-8ZM3 23h8v7H3Zm18 0h8v7h-8ZM16 10v7M7 23v-6h18v6',
  },
  {
    slug: 'supplier-diversity',
    title: ['Supplier diversity', 'Diversité des fournisseurs'],
    summary: ['More inclusive procurement.', 'Des achats plus inclusifs.'],
    icon: 'M16 3 29 10 16 17 3 10ZM3 10v14l13 7 13-7V10M16 17v14M10 6l13 7',
  },
  {
    slug: 'social-impact',
    title: ['Social impact', 'Impact social'],
    summary: [
      'Planning for measurable impact.',
      'Planifier des retombées mesurables.',
    ],
    icon: 'M5 27h23M8 21v-5m8 5V9m8 12V4M4 5h6M7 2v6',
  },
  {
    slug: 'implementation',
    title: ['Implementation support', 'Soutien à la mise en œuvre'],
    summary: [
      'Turning plans into practical solutions.',
      'Transformer les plans en solutions concrètes.',
    ],
    icon: 'M11 5H5v24h22V5h-6M11 3h10v6H11ZM10 19l4 4 9-10',
  },
];
---

<SiteLayout
  locale={locale}
  title={en
    ? 'Different Perspectives. Better Outcomes.'
    : 'Des perspectives différentes. De meilleurs résultats.'}
  description={en
    ? 'Canadian consulting, training, accessibility and implementation solutions for corporations and government. Build stronger, more inclusive workplaces with Diversity.ca.'
    : 'Services-conseils, formation, accessibilité et mise en œuvre pour les entreprises et les organismes publics au Canada. Des milieux de travail plus inclusifs.'}
>
  <section class="home-hero" aria-labelledby="home-title">
    <div class="hero-backdrop">
      <PageImage
        path=""
        locale={locale}
        sizes="(max-width: 760px) 100vw, 60vw"
      />
    </div>
    <div class="container hero-inner">
      <div class="hero-copy">
        <span class="eyebrow"
          >{
            en
              ? 'STRATEGY · ADVISORY · IMPLEMENTATION'
              : 'STRATÉGIE · CONSEIL · MISE EN ŒUVRE'
          }</span
        >
        <h1 id="home-title">
          <span
            >{
              en ? 'Different Perspectives.' : 'Des perspectives différentes.'
            }</span
          >
          <em>{en ? 'Better Outcomes.' : 'De meilleurs résultats.'}</em>
        </h1>
        <p class="lead">
          {
            en
              ? 'Strategic consulting, training, accessibility, and implementation solutions that help Canadian organizations build stronger, more inclusive workplaces.'
              : 'Des services-conseils stratégiques, de la formation et des solutions d’accessibilité et de mise en œuvre pour aider les organisations canadiennes à créer des milieux de travail plus inclusifs et performants.'
          }
        </p>
        <div class="button-row">
          <a href={href('contact')} class="button"
            >{en ? 'Request a consultation' : 'Demander une consultation'}</a
          >
          <a href={href('services')} class="button button-outline"
            >{en ? 'Explore our services' : 'Découvrir nos services'}</a
          >
        </div>
      </div>
    </div>
  </section>
  <section
    class="home-services"
    aria-label={en ? 'Our services' : 'Nos services'}
  >
    <div class="container home-services-grid">
      {
        homepageServices.map((service) => (
          <a class="home-service" href={href(`services/${service.slug}`)}>
            <svg
              viewBox="0 0 32 32"
              width="32"
              height="32"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              focusable="false"
            >
              <path d={service.icon} />
            </svg>
            <h2>{service.title[en ? 0 : 1]}</h2>
            <p>{service.summary[en ? 0 : 1]}</p>
          </a>
        ))
      }
    </div>
  </section>
  <section class="home-about" aria-labelledby="home-about-title">
    <div class="container home-about-inner">
      <span class="eyebrow"
        >{
          en
            ? 'PEOPLE · OPPORTUNITY · PROGRESS'
            : 'PERSONNES · POSSIBILITÉS · PROGRÈS'
        }</span
      >
      <h2 id="home-about-title">
        {
          en
            ? 'Building more inclusive organizations.'
            : 'Bâtir des organisations plus inclusives.'
        }
      </h2>
      <p class="lead">
        {
          en
            ? 'Diversity.ca brings a national perspective to consulting, accessibility, training and implementation for corporate and public-sector organizations. Our focus is practical solutions and measurable progress.'
            : 'Diversity.ca apporte une perspective pancanadienne aux services-conseils, à l’accessibilité, à la formation et à la mise en œuvre pour les entreprises et les organismes publics. Notre priorité : des solutions concrètes et des progrès mesurables.'
        }
      </p>
      <a class="text-link" href={href('about')}
        >{en ? 'Get to know Diversity.ca' : 'Découvrir Diversity.ca'}</a
      >
    </div>
  </section>
  <section class="audience-section">
    <div class="container">
      <div class="section-intro">
        <div>
          <span class="eyebrow"
            >{en ? 'BUILT AROUND YOUR WORLD' : 'ANCRÉ DANS VOTRE RÉALITÉ'}</span
          ><h2>{en ? 'Your context matters.' : 'Votre contexte compte.'}</h2>
        </div><p class="lead">
          {
            en
              ? 'Different responsibilities. Shared ambitions for workplaces, services and communities that work better for everyone.'
              : 'Des responsabilités différentes. Une ambition commune : des milieux de travail, des services et des communautés qui répondent mieux aux besoins de tous.'
          }
        </p>
      </div><div class="audience-grid">
        <a
          class="audience-card audience-card-framed"
          href={href('corporations')}
          ><img
            src={homeImages['@home-corporations'].src}
            alt=""
            width="1500"
            height="1000"
            loading="lazy"
          /><div class="audience-content">
            <span class="eyebrow"
              >{en ? 'FOR CORPORATIONS' : 'POUR LES ENTREPRISES'}</span
            ><h3>
              {
                en
                  ? 'Stronger organizations.\nGreater possibility.'
                  : 'Des organisations plus fortes.\nDe nouvelles possibilités.'
              }
            </h3><p>
              {
                en
                  ? 'Connect your people strategy, customer experience and operations to a more inclusive way of doing business.'
                  : 'Reliez votre stratégie RH, l’expérience client et vos activités à des pratiques plus inclusives.'
              }
            </p><span class="text-link"
              >{
                en
                  ? 'Explore corporate solutions'
                  : 'Découvrir les solutions pour les entreprises'
              }
            </span>
          </div></a
        ><a class="audience-card audience-card-framed" href={href('government')}
          ><img
            src={homeImages['@home-government'].src}
            alt=""
            width="1200"
            height="800"
            loading="lazy"
          /><div class="audience-content">
            <span class="eyebrow"
              >{
                en
                  ? 'FOR GOVERNMENT & PUBLIC SECTOR'
                  : 'POUR LES GOUVERNEMENTS ET LE SECTEUR PUBLIC'
              }</span
            ><h3>
              {
                en
                  ? 'Public purpose.\nPractical progress.'
                  : 'Une mission publique.\nDes progrès concrets.'
              }
            </h3><p>
              {
                en
                  ? 'Bring accessibility, equitable service and accountable delivery into the plans that shape your community.'
                  : 'Intégrez l’accessibilité, des services équitables et une prestation responsable aux plans qui façonnent votre communauté.'
              }
            </p><span class="text-link"
              >{
                en
                  ? 'Explore public sector solutions'
                  : 'Découvrir les solutions pour le secteur public'
              }
            </span>
          </div></a
        >
      </div>
    </div>
  </section>
  <section class="section container approach-section">
    <div>
      <span class="eyebrow"
        >{en ? 'FROM INTENTION TO ACTION' : 'DE L’INTENTION À L’ACTION'}</span
      ><h2>
        {
          en
            ? 'A clear path.\nA human approach.'
            : 'Un parcours clair.\nUne approche humaine.'
        }
      </h2><p class="lead">
        {
          en
            ? 'Progress is built with people, not simply planned for them. We connect listening, thoughtful design and practical implementation.'
            : 'Le progrès se construit avec les personnes concernées. Notre démarche relie l’écoute, une conception réfléchie et la mise en œuvre concrète.'
        }
      </p><a class="text-link" href={href('approach')}
        >{en ? 'Discover our approach' : 'Découvrir notre approche'}
      </a>
    </div><div class="approach-steps">
      {
        steps.map(([title, body], i) => (
          <div class="approach-step">
            <>
              <span class="step-number">0{i + 1}</span>
              <div>
                <>
                  <h3>{title}</h3>
                  <p>{body}</p>
                </>
              </div>
            </>
          </div>
        ))
      }
    </div>
  </section>
  <section class="soft-section">
    <div class="section container">
      <div class="section-intro">
        <div>
          <span class="eyebrow"
            >{en ? 'IDEAS FOR THE WAY FORWARD' : 'DES IDÉES POUR AVANCER'}</span
          ><h2>
            {
              en
                ? 'Perspectives into practice.'
                : 'Des perspectives à la pratique.'
            }
          </h2>
        </div><a class="text-link" href={href('insights')}
          >{en ? 'All insights' : 'Toutes les perspectives'}
        </a>
      </div><div class="insights-grid">
        {
          articles.map((article, i) => (
            <a class="insight-card" href={href(`insights/${article.slug}`)}>
              <>
                <div class="image-wrap">
                  <img
                    src={homeImages[articleImages[i]].src}
                    class:list={{
                      'editorial-illustration':
                        homeImages[articleImages[i]].src.endsWith('.svg'),
                    }}
                    alt=""
                    width="800"
                    height="600"
                    loading="lazy"
                  />
                </div>
                <span class="eyebrow">
                  {en ? 'PRACTICAL GUIDE' : 'GUIDE PRATIQUE'} ·{' '}
                  {en ? '5 MIN READ' : 'LECTURE DE 5 MIN'}
                </span>
                <h3>{article.title[locale]}</h3>
                <span class="text-link">
                  {en ? 'Read the guide' : 'Lire le guide'}{' '}
                </span>
              </>
            </a>
          ))
        }
      </div>
    </div>
  </section>
  <SolutionsTeaser locale={locale} />
  <CoverageLinks locale={locale} />
  <CallToAction locale={locale} />
</SiteLayout>
