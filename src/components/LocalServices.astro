---
import { services, type Locale } from '../data/services';
import type { City } from '../data/locations';
import type { Region } from '../data/regions';
interface Props {
  locale: Locale;
  region?: Region;
  city?: City;
}
const { locale, region, city } = Astro.props;
const en = locale === 'en';
const place = city?.name[locale] ?? region?.name[locale] ?? 'Canada';
const request = (slug: string) => {
  const params = new URLSearchParams({ service: slug });
  if (city) params.set('city', city.slug);
  if (region) params.set('region', region.code);
  return `/${locale}/request-proposal/?${params}`;
};
---

<section
  class="section container location-section"
  id="services"
  aria-labelledby="local-services-title"
>
  <div class="section-intro">
    <div>
      <span class="eyebrow"
        >{
          en ? 'Choose your starting point' : 'Choisissez votre point de départ'
        }</span
      ><h2 id="local-services-title">
        {
          en
            ? `Services for organizations in ${place}.`
            : `Des services pour les organisations — ${place}.`
        }
      </h2>
    </div><p class="lead">
      {
        en
          ? 'Explore a specific scope, see the deliverables and tell us where the work is needed. Services can be combined in one proposal.'
          : 'Explorez un mandat précis, consultez les livrables et indiquez où le travail est nécessaire. Plusieurs services peuvent être réunis dans une proposition.'
      }
    </p>
  </div>
  <nav
    class="location-jumps"
    aria-label={en ? 'Jump to a service' : 'Accès aux services'}
  >
    {
      services.map((service) => (
        <a href={`#${service.slug}`}>{service.shortTitle[locale]}</a>
      ))
    }
  </nav>
  <div style="margin-top:36px">
    {
      services.map((service) => (
        <article class="local-service" id={service.slug}>
          <div>
            <>
              <h3>
                {service.title[locale]} — {place}
              </h3>
              <p>{service.description[locale]}</p>
              <div class="button-row">
                <>
                  <a
                    class="text-link"
                    href={`/${locale}/services/${service.slug}/`}
                  >
                    {en ? 'Scope and approach' : 'Portée et démarche'}
                  </a>
                  <a class="text-link" href={request(service.slug)}>
                    {en ? 'Discuss this service' : 'Discuter de ce service'}
                  </a>
                </>
              </div>
            </>
          </div>
          <div>
            <>
              <h4>{en ? 'Possible deliverables' : 'Livrables possibles'}</h4>
              <ul>
                {service.deliverables[locale].slice(0, 3).map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
              <p class="location-note">
                {en
                  ? 'Explore a focused service:'
                  : 'Explorez un service ciblé :'}
              </p>
              <ul>
                {service.subservices.map((sub) => (
                  <li>
                    <a
                      href={`/${locale}/services/${service.slug}/${sub.slug}/`}
                    >
                      {sub.title[locale]}
                    </a>
                  </li>
                ))}
              </ul>
            </>
          </div>
        </article>
      ))
    }
  </div>
</section>
