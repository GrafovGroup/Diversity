---
import { pathFor, divisions, articles, regions, pages, type Lang, type Page } from '../data/site';
import Picture from './Picture.astro';import Arrow from './Arrow.astro';import Logo from './Logo.astro';import LeadForm from './LeadForm.astro';
interface Props {page:Page;lang:Lang;}
const {page,lang}=Astro.props;const t=(en:string,fr:string)=>lang==='fr'?fr:en;
const division=divisions.find(d=>d.key===page.service);const sub=division?.subs.find(s=>s.key===page.sub);const region=regions.find(r=>r.key===page.region);
const enquiry=page.service==='training'?'training-enquiry':page.service==='accessibility'?'assessment':'proposal';
const intakeParams = new URLSearchParams();
if(page.service) intakeParams.set('service',page.service);
if(page.id==='corporate') intakeParams.set('audience','corporate');
if(['government','public-procurement','capabilities'].includes(page.id)) intakeParams.set('audience','government');
const enquiryLink=pathFor(enquiry,lang)+(intakeParams.size?'?'+intakeParams.toString():'');
---
<div class="container breadcrumbs"><a href={pathFor('home',lang)}>{t('Home','Accueil')}</a><span aria-hidden="true">/</span>{division&&<><a href={pathFor('services',lang)}>{t('Expertise','Expertises')}</a><span aria-hidden="true">/</span></>}{sub&&division&&<><a href={pathFor(division.key,lang)}>{division.title[lang]}</a><span aria-hidden="true">/</span></>}<span aria-current="page">{page.title[lang]}</span></div>
<section class:list={['page-hero','container',{'with-image':Boolean(page.image),'compact-hero':page.kind==='form'}]}><div><p class="eyebrow">{page.eyebrow[lang]}</p><h1>{page.title[lang]}</h1><p class="lead">{page.summary[lang]}</p>{page.kind==='article'?<p class="article-meta">{t('By Diversity.ca editorial · 31 October 2026','Par la rédaction de Diversity.ca · 31 octobre 2026')}</p>:!['form','legal','brand','resources','coverage'].includes(page.kind??'')&&<div class="button-row"><a class="button" href={enquiryLink}>{t('DISCUSS YOUR PROJECT','DISCUTER DE VOTRE PROJET')}<Arrow/></a>{page.id==='government'&&<a class="text-link" href={pathFor('capabilities',lang)}>{t('VIEW CAPABILITIES','VOIR LES CAPACITÉS')}<Arrow/></a>}</div>}</div>{page.image&&<div class="page-hero-image"><Picture name={page.image} lang={lang} eager/></div>}</section>
{page.kind==='form'&&<LeadForm page={page} lang={lang}/>}
{page.kind==='services'&&<section class="section container"><div class="division-grid">{divisions.map((d,i)=><article class="division-card"><Picture name={d.image} lang={lang}/><div><p class="eyebrow">{String(i+1).padStart(2,'0')} / {t('EXPERTISE','EXPERTISE')}</p><h2><a href={pathFor(d.key,lang)}>{d.title[lang]}</a></h2><p>{d.short[lang]}</p><a class="text-link" href={pathFor(d.key,lang)}>{t('EXPLORE THIS DIVISION','EXPLORER CETTE DIVISION')}<Arrow/></a></div></article>)}</div></section>}
{division&&!sub&&<>
 <section class="section container service-intro"><div><p class="eyebrow">{t('THE WORK, DEFINED','UN MANDAT DÉFINI')}</p><h2>{division.short[lang]}</h2><p class="lead">{division.audience[lang]}</p></div><div class="deliverables-panel"><h3>{t('What the engagement can deliver','Ce que le mandat peut livrer')}</h3><ul class="check-list">{division.outcomes.map(o=><li>{o[lang]}</li>)}</ul><p class="small muted">{t('Final methods, deliverables and timelines are agreed in the proposal.','Les méthodes, livrables et échéances sont convenus dans la proposition.')}</p></div></section>
 <section class="section soft"><div class="container"><div class="section-heading"><div><p class="eyebrow">{t('FOCUSED SUPPORT','UN ACCOMPAGNEMENT CIBLÉ')}</p><h2>{t('Explore the services.','Explorer les services.')}</h2></div></div><div class="subservice-grid">{division.subs.map((s,i)=><article class="subservice-card"><span class="service-index">0{i+1}</span><h3><a href={pathFor(s.key,lang)}>{s.title[lang]}</a></h3><p>{s.summary[lang]}</p><a class="text-link" href={pathFor(s.key,lang)}>{t('VIEW SCOPE & DELIVERABLES','VOIR LE MANDAT ET LES LIVRABLES')}<Arrow/></a></article>)}</div></div></section>
 <section class="section container"><div class="section-heading"><div><p class="eyebrow">{t('THE APPROACH','LA DÉMARCHE')}</p><h2>{t('A clear path through the work.','Un cheminement clair.')}</h2></div></div><ol class="process-grid">{division.process.map((p,i)=><li><span>0{i+1}</span><p>{p[lang]}</p></li>)}</ol></section>
 <section class="section faq-section"><div class="container faq-layout"><div><p class="eyebrow">{t('BEFORE WE BEGIN','AVANT DE COMMENCER')}</p><h2>{t('Questions, answered.','Des réponses à vos questions.')}</h2><a class="text-link" href={enquiryLink}>{t('ASK ABOUT YOUR PROJECT','PARLONS DE VOTRE PROJET')}<Arrow/></a></div><div>{division.questions.map(q=><details><summary>{q.q[lang]}</summary><p>{q.a[lang]}</p></details>)}<details><summary>{t('How are fees and timing determined?','Comment sont déterminés les honoraires et les délais?')}</summary><p>{t('They depend on scope, locations, participant numbers, languages and specialist requirements. A proposal sets out the deliverables, assumptions, fees and schedule before work is authorized.','Ils dépendent du périmètre, des lieux, du nombre de participants, des langues et des spécialistes. La proposition précise les livrables, hypothèses, honoraires et échéances avant l’autorisation des travaux.')}</p></details></div></div></section>
 </>}
{sub&&<section class="section container service-intro"><div><p class="eyebrow">{t('HOW THE WORK IS SCOPED','COMMENT DÉFINIR LE MANDAT')}</p><h2>{t('A focused engagement. Useful deliverables.','Un mandat ciblé. Des livrables utiles.')}</h2><p class="lead">{sub.method[lang]}</p><p>{t('The proposal confirms the evidence available, stakeholder participation, review stages, confidentiality and the people responsible for the work. If additional specialist review is needed, that requirement is identified before delivery.','La proposition confirme les données, la participation, les étapes de révision, la confidentialité et les responsables. Tout besoin d’examen spécialisé supplémentaire est précisé avant la prestation.')}</p></div><div class="deliverables-panel"><h3>{t('Deliverables to scope','Livrables à définir')}</h3><ul class="check-list">{sub.deliverables.map(d=><li>{d[lang]}</li>)}</ul><a class="button" href={enquiryLink}>{t('REQUEST A PROPOSAL','DEMANDER UNE PROPOSITION')}<Arrow/></a><p class="small muted">{t('Share your objectives, locations and preferred timeline to start the conversation.','Précisez vos objectifs, lieux et échéances pour entamer la discussion.')}</p></div></section>}
{region&&<div class="container region-line"><p class="eyebrow">{t('PROJECT GEOGRAPHY','TERRITOIRE DU PROJET')}</p><p>{region.metros[lang]}</p><a class="text-link" href={pathFor('proposal',lang)+'?province='+region.key}>{t('DISCUSS A PROJECT HERE','DISCUTER D’UN PROJET ICI')}<Arrow/></a></div>}
{page.sections&&<section class:list={['section','container',{'reading-layout':page.kind==='article'||page.kind==='legal','standard-sections':!['article','legal'].includes(page.kind??''),'industry-grid':page.kind==='industries'}]}>{page.sections.map((s,i)=><article class="content-section" id={`section-${i+1}`}><h2>{s.title[lang]}</h2><div><p>{s.body[lang]}</p>{s.items&&<ul class="check-list">{s.items.map(item=><li>{item[lang]}</li>)}</ul>}</div></article>)}</section>}
{page.kind==='capabilities'&&<section class="section container"><div class="capability-tools"><button class="button" type="button" data-print>{t('PRINT / SAVE OVERVIEW','IMPRIMER / ENREGISTRER L’APERÇU')}<Arrow/></button><p class="small">{t('Print-friendly HTML. Browser PDF output is not a verified tagged PDF.','HTML adapté à l’impression. Le PDF du navigateur n’est pas un PDF balisé vérifié.')}</p></div><div class="capability-grid">{divisions.map(d=><article><h2>{d.title[lang]}</h2><p>{d.short[lang]}</p><ul>{d.subs.map(s=><li>{s.title[lang]}</li>)}</ul></article>)}</div><div class="contact-note"><h2>{t('Languages, coverage and contact','Langues, couverture et coordonnées')}</h2><p>{t('English and French · Canada-wide scoping · Advisory, training and coordinated implementation','Français et anglais · Mandats pancanadiens · Conseil, formation et mise en œuvre coordonnée')}</p><a href="mailto:info@diversity.ca">info@diversity.ca</a></div></section>}
{page.kind==='coverage'&&<section class="section container"><div class="coverage-intro"><h2>{t('Provinces & territories','Provinces et territoires')}</h2><p>{t('Each location page addresses scoping considerations and major service areas. No physical offices are implied.','Chaque page présente les éléments de planification et les principales zones. Aucun bureau physique n’est présumé.')}</p></div><div class="regions-grid">{regions.map(r=><a href={pathFor('region-'+r.key,lang)}><h3>{r.name[lang]}</h3><p>{r.metros[lang]}</p><Arrow/></a>)}</div></section>}
{page.kind==='resources'&&<section class="section container"><div class="article-grid">{articles.map(a=><article class="article-card"><Picture name={a.image!} lang={lang}/><p class="eyebrow">{a.eyebrow[lang]}</p><h2><a href={pathFor(a.id,lang)}>{a.title[lang]}</a></h2><p>{a.summary[lang]}</p><a class="text-link" href={pathFor(a.id,lang)}>{t('READ THE GUIDE','LIRE LE GUIDE')}<Arrow/></a></article>)}</div></section>}
{page.kind==='brand'&&<section class="section container"><div class="brand-review-grid"><div class="brand-sample"><Logo lang={lang} descriptor/><a href="/brand/wordmark-light.svg" download>{t('DOWNLOAD LIGHT SVG','TÉLÉCHARGER LE SVG CLAIR')}</a></div><div class="brand-sample dark"><Logo lang={lang} descriptor dark/><a href="/brand/wordmark-dark.svg" download>{t('DOWNLOAD DARK SVG','TÉLÉCHARGER LE SVG SOMBRE')}</a></div></div><div class="swatches">{['#0A2D6B','#1967F3','#55A6FF','#A855F7','#EC4899'].map(color=><div><span style={`background:${color}`}></span><code>{color}</code></div>)}</div><div class="content-section"><h2>{t('Typography & applications','Typographie et applications')}</h2><p>{t('Inter variable, self-hosted. The wordmark remains complete at all sizes. A typographic D is used only as the browser favicon. Navigation and action labels are uppercase; body text uses dark solid colours for readability.','Inter variable, hébergée localement. Le mot-symbole demeure complet à toutes les tailles. Le D typographique est réservé au favori du navigateur. Les menus et actions sont en majuscules; le texte utilise des couleurs foncées unies.')}</p></div></section>}
{page.sources&&<aside class="container sources"><h2>{t('Further reading','Pour approfondir')}</h2><ul>{page.sources.map(s=><li><a href={s.url} rel="noopener">{s.name}<span aria-hidden="true"> ↗</span></a></li>)}</ul></aside>}
{page.kind==='article'&&<div class="container editorial-note"><p>{t('An editorial planning guide, not a legal opinion or an assurance of compliance. Confirm requirements for your organization and project.','Un guide de planification, et non un avis juridique ni une assurance de conformité. Confirmez les exigences de votre organisation et de votre projet.')}</p></div>}
{(page.related||sub)&&<section class="section container related"><p class="eyebrow">{t('CONTINUE EXPLORING','POURSUIVRE L’EXPLORATION')}</p><div>{(page.related??[division!.key,'approach','proposal']).map(id=>{const related=pages.find(p=>p.id===id)!;return <a href={pathFor(id,lang)}><h3>{related.title[lang]}</h3><Arrow/></a>})}</div></section>}
