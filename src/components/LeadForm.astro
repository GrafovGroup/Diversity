---
import { divisions, regions, pathFor, type Lang, type Page } from '../data/site';
import Arrow from './Arrow.astro';
import { validateEndpoint } from '../lib/intake.mjs';
interface Props { page: Page; lang: Lang; }
const {page,lang}=Astro.props;
const fr=lang==='fr';const t=(en:string,f:string)=>fr?f:en;
const endpoint=validateEndpoint(import.meta.env.PUBLIC_FORM_ENDPOINT??'');
const audienceOptions=[['corporate',t('Corporation / private business','Entreprise privée')],['government',t('Government / public agency','Gouvernement / organisme public')],['education',t('Education','Éducation')],['community',t('Healthcare / community / non-profit','Santé / communauté / organisme sans but lucratif')],['other',t('Other organization','Autre organisation')]];
---
<div class="intake-layout container">
 <aside class="intake-aside"><p class="eyebrow">{t('A CLEAR START','UN DÉPART CLAIR')}</p><h2>{t('A few details help us ask the right questions.','Quelques détails pour poser les bonnes questions.')}</h2><ol class="simple-steps"><li>{t('Tell us what you want to achieve.','Précisez votre objectif.')}</li><li>{t('We discuss the scope and delivery needs.','Nous discutons du mandat et des besoins.')}</li><li>{t('Agree on a proposal and next steps.','Convenons d’une proposition et des suites.')}</li></ol><div class="contact-note"><p>{t('Prefer to write directly?','Vous préférez nous écrire directement?')}</p><a href="mailto:info@diversity.ca">info@diversity.ca <span aria-hidden="true">↗</span></a></div><p class="small muted">{t('Please do not include sensitive employee information, medical details or confidential procurement documents. We can agree on a suitable transfer method later.','N’incluez pas de renseignements sensibles sur le personnel, de détails médicaux ni de documents d’achat confidentiels. Un mode de transfert approprié pourra être convenu ensuite.')}</p></aside>
 <div class="form-panel">
 <div class="form-notice" id="form-mode"><strong>{endpoint?t('Secure form submission via Formspree','Envoi du formulaire par Formspree'):t('Your enquiry starts by email','Votre demande commence par courriel')}</strong><p>{endpoint?t('Your details will be sent to Formspree for delivery to Diversity.ca.','Vos renseignements seront transmis à Formspree pour être remis à Diversity.ca.'):t('This form prepares a draft in your email app. Review it and send it there. Nothing is sent when you prepare the draft.','Ce formulaire prépare un brouillon dans votre application courriel. Vérifiez-le et envoyez-le depuis cette application. La préparation n’envoie aucun message.')}</p>{endpoint&&<a href="https://formspree.io/legal/privacy-policy/">{t('Formspree privacy policy','Politique de confidentialité de Formspree')}</a>}</div>
 <noscript><p class="form-notice">{t('JavaScript is needed for this form. Please email your project details to','Ce formulaire nécessite JavaScript. Veuillez envoyer votre projet à')} <a href="mailto:info@diversity.ca">info@diversity.ca</a>.</p></noscript>
 <form id="lead-form" data-endpoint={endpoint} data-language={lang} data-intake={page.id} aria-describedby="form-mode" method="post" action={endpoint||'mailto:info@diversity.ca'} enctype={endpoint?'multipart/form-data':'text/plain'}>
 <p class="small">{t('Fields marked * are required.','Les champs marqués * sont obligatoires.')}</p>
 <div class="form-grid">
 <div class="field"><label for="name">{t('Your name *','Votre nom *')}</label><input id="name" name="name" autocomplete="name" required maxlength="100" /></div>
 <div class="field"><label for="email">{t('Work email *','Courriel professionnel *')}</label><input type="email" id="email" name="email" autocomplete="email" required maxlength="180" /></div>
 <div class="field"><label for="organization">{t('Organization *','Organisation *')}</label><input id="organization" name="organization" autocomplete="organization" required maxlength="150" /></div>
 <div class="field"><label for="audience">{t('Organization type *','Type d’organisation *')}</label><select id="audience" name="audience" required><option value="">{t('Select an option','Choisir une option')}</option>{audienceOptions.map(([value,label])=><option value={value}>{label}</option>)}</select></div>
 <div class="field full"><label for="service">{t('Primary service *','Service principal *')}</label><select id="service" name="service" required><option value="">{t('Select a service','Choisir un service')}</option>{divisions.map(d=><option value={d.key} selected={page.id==='training-enquiry'&&d.key==='training'}>{d.title[lang]}</option>)}<option value="unsure">{t('Several services / help me decide','Plusieurs services / à déterminer')}</option></select></div>
 <div class="field"><label for="province">{t('Province / territory *','Province / territoire *')}</label><select id="province" name="province" required><option value="">{t('Select a location','Choisir un territoire')}</option><option value="national">{t('Canada-wide / multiple locations','Canada / plusieurs territoires')}</option>{regions.map(r=><option value={r.key}>{r.name[lang]}</option>)}</select></div>
 <div class="field"><label for="city">{t('City / site locations','Ville / lieux')}</label><input id="city" name="city" autocomplete="address-level2" maxlength="180" /></div>
 <div class="field"><label for="timeline">{t('Preferred timeline','Échéancier souhaité')}</label><select id="timeline" name="timeline"><option value="">{t('To be discussed','À discuter')}</option><option value="asap">{t('As soon as practical','Dès que possible')}</option><option value="1-3-months">{t('1–3 months','1 à 3 mois')}</option><option value="3-6-months">{t('3–6 months','3 à 6 mois')}</option><option value="planning">{t('Planning / next budget cycle','Planification / prochain budget')}</option></select></div>
 <div class="field"><label for="budget">{t('Indicative budget (CAD)','Budget indicatif (CAD)')}</label><select id="budget" name="budget"><option value="">{t('Not set / prefer to discuss','Non établi / à discuter')}</option><option value="under-10000">{t('Under $10,000','Moins de 10 000 $')}</option><option value="10000-25000">{t('$10,000–$25,000','10 000 $ à 25 000 $')}</option><option value="25000-75000">{t('$25,000–$75,000','25 000 $ à 75 000 $')}</option><option value="75000-plus">{t('$75,000+','75 000 $ et plus')}</option></select></div>
 {page.id==='training-enquiry'&&<><div class="field"><label for="participants">{t('Approximate participants','Nombre approximatif de participants')}</label><input type="number" id="participants" name="participants" min="1" max="100000" /></div><div class="field"><label for="format">{t('Delivery format','Format')}</label><select id="format" name="format"><option value="discuss">{t('To discuss','À discuter')}</option><option value="virtual">{t('Virtual','À distance')}</option><option value="in-person">{t('In person','En personne')}</option><option value="hybrid">{t('Hybrid','Hybride')}</option></select></div></>}
 {page.id==='assessment'&&<div class="field full"><label for="assessment_scope">{t('Assessment focus','Objet de l’évaluation')}</label><select id="assessment_scope" name="assessment_scope"><option value="organization">{t('Organization / workforce / policies','Organisation / personnel / politiques')}</option><option value="digital">{t('Website / digital experience','Site web / expérience numérique')}</option><option value="physical">{t('Building / physical environment','Bâtiment / environnement physique')}</option><option value="combined">{t('Combined / to discuss','Combiné / à discuter')}</option></select></div>}
 </div>
 <details class="rfp-fields" open={page.id==='proposal'}><summary>{t('Procurement or RFP details (optional)','Détails d’approvisionnement ou d’appel d’offres (facultatifs)')}</summary><div class="form-grid"><div class="field"><label for="reference">{t('Reference number','Numéro de référence')}</label><input id="reference" name="reference" maxlength="100" /></div><div class="field"><label for="deadline">{t('Response deadline','Échéance de réponse')}</label><input type="datetime-local" id="deadline" name="deadline" /></div><div class="field"><label for="deadline_timezone">{t('Deadline time zone','Fuseau horaire de l’échéance')}</label><select id="deadline_timezone" name="deadline_timezone"><option value="">{t('Select if deadline supplied','Choisir si une échéance est fournie')}</option>{['America/St_Johns','America/Halifax','America/Toronto','America/Winnipeg','America/Regina','America/Edmonton','America/Vancouver','America/Whitehorse','America/Iqaluit'].map(v=><option value={v}>{v}</option>)}</select></div><div class="field"><label for="public_link">{t('Public project / tender URL','Lien public du projet / appel d’offres')}</label><input type="url" id="public_link" name="public_link" maxlength="500" placeholder="https://" /></div></div><p class="small muted">{t('This enquiry does not submit a bid to government. Attachments are not accepted here.','Cette demande ne dépose pas de soumission au gouvernement. Aucune pièce jointe n’est acceptée ici.')}</p></details>
 <div class="field"><label for="message">{t('What would you like to achieve? *','Quel est votre objectif? *')}</label><textarea id="message" name="message" rows="5" minlength="20" maxlength="1600" required aria-describedby="message-help"></textarea><span id="message-help" class="small muted">{t('20–1,600 characters. Include preferred delivery language and any participation needs, without sensitive personal details.','20 à 1 600 caractères. Précisez la langue et les besoins de participation, sans détails personnels sensibles.')}</span></div>
 <div class="honeypot" aria-hidden="true"><label for="website">Website</label><input id="website" name="_gotcha" tabindex="-1" autocomplete="off" /></div>
 <label class="consent"><input type="checkbox" name="consent" value="agreed" required /><span>{t('I agree that my enquiry details may be used to respond and discuss this project. I have read the','J’accepte que mes renseignements servent à répondre et à discuter du projet. J’ai lu l’')} <a href={pathFor('privacy',lang)}>{t('privacy notice','avis de confidentialité')}</a>. *</span></label>
 <div class="form-actions"><button class="button" type="submit">{endpoint?t('SEND ENQUIRY','ENVOYER LA DEMANDE'):t('PREPARE EMAIL','PRÉPARER LE COURRIEL')}<Arrow/></button><button class="text-button" type="button" data-download>{t('SAVE REQUEST AS JSON','ENREGISTRER EN JSON')}</button></div>
 <p id="form-status" role="status" aria-live="polite" tabindex="-1"></p>
 <div id="fallback-actions" hidden><a class="text-link" id="email-fallback" href="mailto:info@diversity.ca">{t('Open email draft','Ouvrir le brouillon')}</a><button class="text-button" type="button" data-copy>{t('COPY REQUEST','COPIER LA DEMANDE')}</button><p class="small">{t('If your email app does not open, copy your request and email it to info@diversity.ca.','Si votre application ne s’ouvre pas, copiez la demande et envoyez-la à info@diversity.ca.')}</p></div>
 </form></div>
</div>
<script>
 import { leadRecord, createMailto, recordText } from '../lib/intake.mjs';
 const form=document.querySelector<HTMLFormElement>('#lead-form');
 if(form){
 const fr=form.dataset.language==='fr';const t=(en:string,f:string)=>fr?f:en;
 const status=document.querySelector<HTMLElement>('#form-status')!;
 const fallback=document.querySelector<HTMLElement>('#fallback-actions')!;
 const link=document.querySelector<HTMLAnchorElement>('#email-fallback')!;
 const subject=t('Diversity.ca project enquiry','Diversity.ca — demande de projet');
 const params=new URLSearchParams(window.location.search);
 for(const key of ['service','audience','province']){const select=form.elements.namedItem(key);const value=params.get(key);if(select instanceof HTMLSelectElement&&value&&Array.from(select.options).some(o=>o.value===value))select.value=value;}
 const deadline=form.elements.namedItem('deadline') as HTMLInputElement;
 const zone=form.elements.namedItem('deadline_timezone') as HTMLSelectElement;
 deadline?.addEventListener('input',()=>{zone.required=Boolean(deadline.value);});
 const record=()=>leadRecord(new FormData(form),{language:form.dataset.language,intake:form.dataset.intake,source_path:window.location.pathname});
 const showFallback=()=>{const mailto=createMailto(record(),subject);link.href=mailto;fallback.hidden=false;return mailto;};
 form.addEventListener('submit',async event=>{
   event.preventDefault();if(!form.reportValidity())return;
   if((form.elements.namedItem('_gotcha') as HTMLInputElement).value){status.textContent=t('Please email us directly to complete your enquiry.','Veuillez nous écrire directement pour compléter la demande.');return;}
   const endpoint=form.dataset.endpoint;
   if(!endpoint){showFallback();status.textContent=t('Your email draft is ready. Open it below, review it and send it from your email app. Nothing has been sent yet.','Votre brouillon est prêt. Ouvrez-le ci-dessous, vérifiez-le et envoyez-le depuis votre application. Aucun message n’a été envoyé.');status.focus();return;}
   const button=form.querySelector<HTMLButtonElement>('button[type="submit"]')!;button.disabled=true;status.textContent=t('Sending your enquiry…','Envoi de votre demande…');
   const controller=new AbortController();const timeout=window.setTimeout(()=>controller.abort(),15000);
   try{const body=new FormData(form);body.set('language',form.dataset.language??'en');body.set('intake',form.dataset.intake??'contact');body.set('source_path',window.location.pathname);const response=await fetch(endpoint,{method:'POST',body,headers:{Accept:'application/json'},signal:controller.signal});const result=await response.json();if(!response.ok||result.ok!==true)throw new Error('Submission not confirmed');status.textContent=t('Your enquiry was accepted by the form service. We will use the email address you provided to follow up.','Votre demande a été acceptée par le service de formulaire. Nous utiliserons le courriel fourni pour le suivi.');form.reset();fallback.hidden=true;}
   catch{status.textContent=t('Delivery could not be confirmed. Your details are still here. You can send them by email instead; if the provider received the first attempt, a duplicate may occur.','La livraison n’a pas pu être confirmée. Vos renseignements sont conservés dans le formulaire. Vous pouvez les envoyer par courriel; un doublon est possible si le premier envoi a été reçu.');showFallback();}
   finally{window.clearTimeout(timeout);button.disabled=false;status.focus();}
 });
 form.querySelector('[data-download]')?.addEventListener('click',()=>{if(!form.reportValidity())return;const blob=new Blob([JSON.stringify(record(),null,2)],{type:'application/json'});const url=URL.createObjectURL(blob);const a=document.createElement('a');a.href=url;a.download='diversity-project-request.json';a.click();window.setTimeout(()=>URL.revokeObjectURL(url),5000);status.textContent=t('Your request was saved to a JSON file. It has not been sent.','Votre demande a été enregistrée en JSON. Elle n’a pas été envoyée.');});
 form.querySelector('[data-copy]')?.addEventListener('click',async()=>{try{await navigator.clipboard.writeText(recordText(record()));status.textContent=t('Request copied. Paste it into an email to info@diversity.ca.','Demande copiée. Collez-la dans un courriel à info@diversity.ca.');}catch{status.textContent=t('Copying is unavailable. Use the email link or save your request as JSON.','La copie est indisponible. Utilisez le lien courriel ou enregistrez la demande en JSON.');}});
 }
</script>
