---
import '../styles/global.css';
---

<!doctype html>
<html lang="en-CA">
  <head
    ><meta charset="utf-8" /><meta
      name="viewport"
      content="width=device-width,initial-scale=1"
    /><meta name="robots" content="noindex" /><title>
      Page not found · Page introuvable | Diversity.ca
    </title></head
  ><body
    ><main class="container section">
      <span class="eyebrow">DIVERSITY.CA · 404</span><h1
        style="font-size:clamp(3rem,8vw,6rem)"
      >
        A different way forward.
      </h1><p class="lead">
        We couldn’t find that page. Let’s get you back on track.
      </p><p class="lead" lang="fr">
        Cette page est introuvable. Retrouvons le bon chemin.
      </p>
      <img
        src="/images/pages/not-found.svg"
        alt="An illustrated path turns away from a closed route and towards a new destination."
        width="1200"
        height="900"
        style="max-width:560px;margin:30px 0"
      />
      <div class="button-row">
        <a class="button" href="/en/">English home ↗</a><a
          class="button button-outline"
          href="/fr/"
          lang="fr">Accueil en français ↗</a
        >
      </div>
    </main></body
  >
</html>
